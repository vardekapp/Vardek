+    /// On USB re-enumeration (wake/replug) the HID device can match before macOS
+    /// re-registers the display, leaving no mapper and dropping every touch. Retry
+    /// resolution every 2 s for up to 30 s so the driver heals without user input.
+    /// Must be called on gestureQueue.
+    private func scheduleDisplayRetryTimer() {
+        guard displayRetryTimer == nil else {
+            return
+        }
+
+        displayRetryAttemptsRemaining = 15
+        DriverLoggers.log(.notice, category: .display, "Scheduling display resolution retry every 2 s (up to 30 s).")
+
+        let timer = DispatchSource.makeTimerSource(queue: gestureQueue)
+        timer.schedule(deadline: .now() + .seconds(2), repeating: .seconds(2))
+        timer.setEventHandler { [weak self] in
+            guard let self else {
+                return
+            }
+
+            self.displayRetryAttemptsRemaining -= 1
+            if self.displayRetryAttemptsRemaining < 0 {
+                DriverLoggers.log(.error, category: .display, "Display resolution retries exhausted; will retry on the next display or HID event.")
+                self.cancelDisplayRetryTimer()
+                return
             }
+
+            self.refreshDisplayMapping(reason: "display resolution retry")
         }
+        timer.resume()
+        displayRetryTimer = timer
+    }
+
+    /// Must be called on gestureQueue.
+    private func cancelDisplayRetryTimer() {
+        displayRetryTimer?.setEventHandler {}
+        displayRetryTimer?.cancel()
+        displayRetryTimer = nil
     }
 
